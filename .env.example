# Copy to .env and fill in — or set TYPESAFE_API_KEY in the environment that starts pi,
# or use pi's /login with a Jev provider (OpenRouter, Cloudflare, Vercel, opencode).
TYPESAFE_API_KEY=

# TypeLLM (optional second classifier provider; key file preferred so each
# project keeps its own key: ~/.config/pi-codemap/typellm.key via
# `npx tsx ext/typellm.ts setup`)
#export TYPELLM_API_KEY=

# Classifier provider: jev | typellm | auto (default auto = jev, fallback typellm)
#export CODEMAP_CLASSIFIER=auto
